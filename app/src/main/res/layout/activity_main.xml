<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="跨软件取词 Demo"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="类似欧陆词典：在任意 App 选中英文单词，自动弹出浮窗释义。"
        android:textSize="14sp"
        android:textColor="#555555"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. 开启无障碍服务（取词核心）" />

    <Button
        android:id="@+id/btnTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="查词测试" />

    <EditText
        android:id="@+id/etTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="输入单词测试（如 computer）"
        android:inputType="text"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginTop="16dp"
        android:text="步骤：点上方开启无障碍服务 → 在列表里找到「取词Demo」并打开 → 去任意 App 选中英文，右上角自动浮出释义卡片。无需悬浮窗权限、无需启动按钮。" />
</LinearLayout>
